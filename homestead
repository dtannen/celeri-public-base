server {
    listen 80 default_server;

    server_name celeri.test;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";

    root /var/www/html/app/public;
    index index.html index.htm index.php;
    charset utf-8;

    # Published assets carry a SHA-256 generation in the path. Match these before
    # the PHP handler and never send missing or non-asset paths to Laravel.
    location ~ "^/nova-static/[0-9a-f]{64}/.+\.(?:js|css|map|LICENSE\.txt|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$" {
        try_files $uri =404;

        include /etc/nginx/mime.types;
        types { application/json map; }
        gzip on;
        gzip_static on;
        gzip_vary on;
        gzip_proxied any;
        gzip_comp_level 5;
        gzip_min_length 1024;
        gzip_types application/javascript text/css image/svg+xml application/json text/plain;

        # add_header in a location replaces inherited headers. Keep all three
        # security headers, and omit immutable caching on unsuccessful responses.
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
        add_header X-XSS-Protection "1; mode=block";
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ ^/nova-static(?:/|$) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    access_log off;
    error_log  /var/log/nginx/app-error.log error;
    sendfile off;
    client_max_body_size 100m;

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/celeri-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        fastcgi_read_timeout 300;
    }

    location ~ /\.ht {
        deny all;
    }
}
